PORT=3000
NODE_ENV=development

# PostgreSQL connection string — required. Copy this file to .env and put
# your real one there (.env is gitignored, never commit real credentials).
DATABASE_URL=postgresql://user:password@localhost:5432/database_name

# Supabase Storage — used to store appointment before/after photos as real
# objects instead of embedding base64 data in the database row.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Web Push notifications — generate once with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# then set the SAME three values here AND in the Vercel project's
# Environment Variables (Settings → Environment Variables) so production
# can send pushes too. Never rotate these once real devices have
# subscribed — a key change invalidates every existing subscription.
VAPID_PUBLIC_KEY=your-public-key
VAPID_PRIVATE_KEY=your-private-key
VAPID_SUBJECT=mailto:you@example.com

# WhatsApp via Twilio — connects the company WhatsApp number to the AI
# booking assistant. Get Account SID + Auth Token from the Twilio Console
# (console.twilio.com) main dashboard. TWILIO_WHATSAPP_NUMBER is the
# "From" address Twilio sends as — the Sandbox number while testing
# (whatsapp:+14155238886) or your approved WhatsApp Sender once live
# (whatsapp:+9665XXXXXXXX). Set the webhook URL in Twilio Console →
# Messaging → Try it out / Senders → "When a message comes in" to:
#   https://zuhaclean.vercel.app/api/whatsapp/webhook
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# Mobile app login code (WhatsApp). WhatsApp only allows free-form text within
# 24h of the customer's last message, so real delivery of the login code needs
# an approved WhatsApp *authentication* template: create it in Twilio Console →
# Messaging → Content Template Builder (variable {{1}} = the 6-digit code), get
# it approved, then paste its Content SID (HX...) here. Leave empty to send
# plain text (works with the Sandbox number only).
TWILIO_WHATSAPP_OTP_CONTENT_SID=

# Anthropic API — powers the WhatsApp AI booking assistant's replies and
# extraction. Create a key at console.anthropic.com (Settings → API Keys)
# under the workspace that has billing enabled.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Set all 4 of the values above in the Vercel dashboard too (Project →
# Settings → Environment Variables) — local .env and Vercel's production
# env are separate, same as every other secret in this file.

# Tamara (Pay by Instalments) — lets staff create a real payment request
# from inside PayAppointmentModal instead of the Tamara Business Portal.
# TAMARA_API_TOKEN comes from the Tamara Business Portal (Settings → API
# Keys). Leave TAMARA_API_URL unset to use the Sandbox — only point it at
# https://api.tamara.co once a test order has gone through successfully.
# TAMARA_NOTIFICATION_TOKEN is generated when you register the webhook URL
# below in the Tamara Business Portal (Settings → Webhooks) — must match
# exactly, or every incoming notification is rejected with 401.
#   Webhook URL to register with Tamara: https://zuhaclean.vercel.app/api/tamara/webhook
TAMARA_API_URL=https://api-sandbox.tamara.co
TAMARA_API_TOKEN=your-tamara-api-token
TAMARA_NOTIFICATION_TOKEN=your-tamara-webhook-notification-token

# Tabby (Pay in Instalments) — same idea as Tamara above, from the same
# PayAppointmentModal. TABBY_SECRET_KEY and TABBY_MERCHANT_CODE both come
# from the Tabby Merchant Portal (Developers → API Keys); merchant_code is
# specific to your store + currency, not the same thing as the secret key.
# No webhook to register here — Tabby's confirmation comes back through the
# customer's own browser redirect (GET /api/tabby/return, wired in
# automatically via merchant_urls when the request is created), not a
# server-to-server callback, so there is nothing to configure on Tabby's
# side beyond the two keys below.
TABBY_API_URL=https://api.tabby.ai
TABBY_SECRET_KEY=your-tabby-secret-key
TABBY_MERCHANT_CODE=your-tabby-merchant-code
