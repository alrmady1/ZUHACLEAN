PORT=3000
NODE_ENV=development

# PostgreSQL connection string — required. Copy this file to .env and put
# your real one there (.env is gitignored, never commit real credentials).
DATABASE_URL=postgresql://user:password@localhost:5432/database_name

# Supabase Storage — used to store appointment before/after photos as real
# objects instead of embedding base64 data in the database row.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Web Push notifications — generate once with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# then set the SAME three values here AND in the Vercel project's
# Environment Variables (Settings → Environment Variables) so production
# can send pushes too. Never rotate these once real devices have
# subscribed — a key change invalidates every existing subscription.
VAPID_PUBLIC_KEY=your-public-key
VAPID_PRIVATE_KEY=your-private-key
VAPID_SUBJECT=mailto:you@example.com
