PORT=3000
NODE_ENV=development

# PostgreSQL connection string — required. Copy this file to .env and put
# your real one there (.env is gitignored, never commit real credentials).
DATABASE_URL=postgresql://user:password@localhost:5432/database_name

# Supabase Storage — used to store appointment before/after photos as real
# objects instead of embedding base64 data in the database row.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Web Push notifications — generate once with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# then set the SAME three values here AND in the Vercel project's
# Environment Variables (Settings → Environment Variables) so production
# can send pushes too. Never rotate these once real devices have
# subscribed — a key change invalidates every existing subscription.
VAPID_PUBLIC_KEY=your-public-key
VAPID_PRIVATE_KEY=your-private-key
VAPID_SUBJECT=mailto:you@example.com

# WhatsApp via Twilio — connects the company WhatsApp number to the AI
# booking assistant. Get Account SID + Auth Token from the Twilio Console
# (console.twilio.com) main dashboard. TWILIO_WHATSAPP_NUMBER is the
# "From" address Twilio sends as — the Sandbox number while testing
# (whatsapp:+14155238886) or your approved WhatsApp Sender once live
# (whatsapp:+9665XXXXXXXX). Set the webhook URL in Twilio Console →
# Messaging → Try it out / Senders → "When a message comes in" to:
#   https://zuhaclean.vercel.app/api/whatsapp/webhook
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Anthropic API — powers the WhatsApp AI booking assistant's replies and
# extraction. Create a key at console.anthropic.com (Settings → API Keys)
# under the workspace that has billing enabled.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Set all 4 of the values above in the Vercel dashboard too (Project →
# Settings → Environment Variables) — local .env and Vercel's production
# env are separate, same as every other secret in this file.
